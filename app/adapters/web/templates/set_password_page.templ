package templates

import "gitlab.com/shaninalex/lumna/app/modules/auth/contract"

templ SetPasswordPage(invitation contract.InvitationClaims, err error) {
	<html xmlns="http://www.w3.org/1999/xhtml">
		<head>
			<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
			<meta name="viewport" content="initial-scale=1.0, width=device-width"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<link href="/assets/css/styles.min.css" rel="stylesheet"/>
		</head>
		<body>
			<form action="" method="post" class="container">
				<div class="row">
					<div class="offset-md-3 col-md-6">
						<div class="card my-4">
							<div class="card-body">
								<h3 class="card-title">Set password</h3>
								<p>Hello <b>{ invitation.Email }</b>! You have been invited in Lumna as a <b>{ invitation.Role }</b>.</p>
								<p>Please, set up your password to complete registration</p>

								<label for="fullName" class="form-label">Full Name</label>
								<input name="full_name" type="text" id="fullName" class="form-control" required />

								<label for="inputPassword" class="form-label">Password</label>
								<input name="password" type="password" id="inputPassword" class="form-control" required />

								<label for="inputPasswordConfirm" class="form-label">Password confirm</label>
								<input name="password_confirm" type="password" id="inputPasswordConfirm" class="form-control" required />

								<div id="passwordHelpBlock" class="form-text">
									Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
								</div>

								if err != nil {
									<div class="alert alert-danger small">Error: {err.Error()}</div>
								}

								<hr/>
								<div class="d-flex justify-content-end">
									<button type="submit" class="btn btn-primary">Submit</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</form>
		</body>
	</html>
}
